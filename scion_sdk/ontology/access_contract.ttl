# Access-contract vocabulary (SCION-CONNECTOR-CONTROL-R021).
#
# A connector ontology declares, per ontology class, how a consumer reads it
# live. Field names align with agent-utilities VirtualMapping:
# sourceId, entity, classIri, keyField and PropertyBinding (property -> field).
# Contracts use the flat Turtle profile that access_contract.py parses:
# prefixed names or <IRIs>, string or integer literals, no blank nodes.

@prefix ac:   <https://knuckles-team.github.io/agent-connector-sdk/access#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ac:AccessContract a owl:Class ;
    rdfs:comment "How one ontology class is answered live by one source operation." .

ac:PropertyBinding a owl:Class ;
    rdfs:comment "One ontology property bound to one source field of a contract." .

ac:classIri a owl:ObjectProperty ; rdfs:domain ac:AccessContract ;
    rdfs:comment "The ontology class this contract answers (VirtualMapping.class_iri)." .
ac:sourceId a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string ;
    rdfs:comment "The source connection identifier (VirtualMapping.source_id)." .
ac:entity a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string ;
    rdfs:comment "The source entity name (VirtualMapping.entity)." .
ac:keyField a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string ;
    rdfs:comment "The source field holding the entity key (VirtualMapping.key_field)." .

ac:accessKind a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string ;
    rdfs:comment "A declared connection-protocol term such as virtual_graph. Declaration alone does not establish transport availability." .
ac:operation a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string ;
    rdfs:comment "The MCP tool name, endpoint path, GraphQL query name or A2A skill id." .
ac:parameter a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string ;
    rdfs:comment "One parameter name the operation accepts. Repeatable." .
ac:pagination a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string ;
    rdfs:comment "One of none, cursor, offset, page, range, sync_token or batch." .
ac:pushdown a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string ;
    rdfs:comment "One operation the source executes itself: filter, sort, limit, project, aggregate, join or time_range. Repeatable." .
ac:authRef a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string ;
    rdfs:comment "A credential reference (env://NAME or openbao://mount/path#field). Never a secret." .
ac:rateLimitPerMinute a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:integer .
ac:freshnessSeconds a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:integer ;
    rdfs:comment "Maximum acceptable staleness. Small values favour live reads." .
ac:costHint a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string ;
    rdfs:comment "One of low, medium, high. High cost favours a copied hot slice." .

ac:contract a owl:ObjectProperty ; rdfs:domain ac:PropertyBinding ; rdfs:range ac:AccessContract .
ac:property a owl:ObjectProperty ; rdfs:domain ac:PropertyBinding .
ac:field a owl:DatatypeProperty ; rdfs:domain ac:PropertyBinding ; rdfs:range xsd:string .

ac:authModel a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string ;
    rdfs:comment "The declared transport authentication model, never a credential value." .
ac:streaming a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string ;
    rdfs:comment "The declared stream form, or none for a non-streaming transport." .

# Explicit result and paging mechanics. Missing values are not defaults: a
# consumer must refuse a paged read whose completion cannot be established.
ac:recordsPath a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string .
ac:paginationParam a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string .
ac:nextCursorPath a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string .
ac:pageSize a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:integer .
ac:pageSizeParam a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string .
ac:startPage a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:integer .
ac:startOffset a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:integer .
ac:completion a owl:DatatypeProperty ; rdfs:domain ac:AccessContract ; rdfs:range xsd:string .
